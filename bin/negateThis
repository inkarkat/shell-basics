#!/bin/bash
shopt -qs extglob

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "$(basename "$1")" '[--status-99-is-noop] [--] COMMAND [ARG ...] [-?|-h|--help]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Negate the exit status of the supplied command; a success turns into 1 and any
failure into 0.
HELPDESCRIPTION
    echo
    cat <<HELPTEXT
    --status-99-is-noop An exit status of 99 from COMMAND signifies no action or
			inapplicability, and is treated like success.
SEE ALSO:
- succeedThis, failThis, acceptStatus
HELPTEXT
}

additionalSuccessStatus=
case "$1" in
    --help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
    --status-99-is-noop)
			shift; additionalSuccessStatus=99;;
    --)			shift;;
esac
if [ $# -eq 0 ]; then
    echo >&2 'ERROR: No COMMAND passed.'
    echo >&2
    printUsage "$0" >&2
    exit 2
fi

printf -v quotedSimpleCommand '%q ' "$@"
eval "${quotedSimpleCommand% }"; status=$?
if [ $status -eq 0 -o $status -eq ${additionalSuccessStatus:--1} ]; then
    exit 1
else
    exit 0
fi
