#!/bin/bash

printUsage()
{
    cat <<HELPTEXT
Print the original singular of WHAT or WHATs / WHAT-PLURAL, depending on the
value of N.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" 'N WHAT [WHAT-PLURAL] [-?|-h|--help]'
}

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

if [ "${1:?}" -eq 1 ]; then
    printf %s "${2}${4}"
else
    printf %s "${2}${3:-s}"
fi
