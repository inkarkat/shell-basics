#!/bin/bash

printUsage()
{
    cat <<HELPTEXT
Convert the passed GLOB with pathname expansion semantics (i.e. * is limited to
a single path component, ** matches any number of path components including
none) to a GLOB with standard shell globbing semantics (* matches any number of
characters in a single path component, ** is the same as *).
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[--] GLOB [...] [-?|-h|--help]'
}

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
    --)			shift;;
esac
if [ $# -eq 0 ]; then
    printUsage "$0" >&2
    exit 2
fi

parseCharacterClass()
{
    local s="${1?}" slen=${#1} j
    for ((j = 0; j < slen; j++))
    do
	local isFirst=
	if ((j == 0)); then
	    isFirst=t
	    if [ "${s:j:1}" = '!' ] || [ "${s:j:1}" = '^' ]; then	# Character class negation.
		let j+=1
	    fi
	fi
	if [ "${s:j:1}" = ']' ]; then
	    [ "$isFirst" ] && continue  # A ] may be matched by including it as the first character in the set.

	    printf '%d-%s' $((j + 1)) "${s:0:j+1}"
	    return 0
	fi
    done
    return 1
}

parseExtendedGlob()
{
    local s="${1?}" slen=${#1} j

    [[ "${s:0:1}" = [?*+@!] ]] || return 1
    [ "${s:1:1}" = '(' ] || return 1

    for ((j = 2; j < slen; j++))
    do
	if [ "${s:j:1}" = ')' ]; then
	    printf '%d-%s' $((j + 1)) "${s:0:j+1}"
	    return 0
	fi
    done
    return 1
}

parse()
{
    local s="${1?}" slen=${#1}; shift
    local j="${1:?}"; shift

    if ((slen == 0)); then
	return 1
    # Backslash takes the next character literally.
    elif [ "${s:0:1}" = \\ ] && ((slen > 1)); then
	printf '2-%s' "${s:0:2}"
    elif [ "${s:0:1}" = '[' ]; then
	if p=$(parseCharacterClass "${s:1}"); then
	    n="${p%%-*}"; text="${p#*-}"
	    printf '%d-%s' $((n+1)) "${s:0:1}$text"
	else
	    printf '1-%s' "${s:0:1}"
	fi
    # Double asterisk matches any number of path components, including none.
    elif [ "${s:0:4}" = '/**/' ]; then
	printf '4-?(/*/)'
    elif ((i == 0)) && [ "${s:0:3}" = '**/' ]; then	# Need to check for the actual start of the glob, not the start of the parse, so i, not j.
	printf '3-?(*/)'
    elif ((slen == 3)) && [ "${s:0:3}" = '/**' ]; then
	printf '3-/*'
    # Double asterisk not delimited by slashes or at the beginning or end of the
    # glob matches like a single asterisk.
    elif [ "${s:0:2}" = '**' ]; then
	if [ "${s:2:1}" = '(' ] \
	    && p=$(parseExtendedGlob "${s:1}")
	then
	    # It's actually a single asterisk followed by an extended *(...) glob.
	    n="${p%%-*}"; text="${p#*-}"
	    printf '%d-%s' $((n+1)) "*([^/])$text"
	else
	    printf '2-*([^/])'
	fi
    # Single asterisk matches any number of characters in a single path component.
    elif [ "${s:0:1}" = '*' ]; then
	if [ "${s:1:1}" = '(' ] \
	    && p=$(parseExtendedGlob "$s")
	then
	    n="${p%%-*}"; text="${p#*-}"
	    printf '%d-%s' $n "$text"
	else
	    printf '1-*([^/])'
	fi
    # Everything else is taken literally.
    else
	printf '1-%s' "${s:0:1}"
    fi
}

for g
do
    r=''
    let i=0
    while p="$(parse "${g:i}" $i)"
    do
	n="${p%%-*}"; text="${p#*-}"
	r+="$text"
	let i+=n
    done
    printf '%s\n' "$r"
done
